modules = ["nodejs-20", "python-3.12", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web"

[[workflows.workflow]]
name = "web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/neonoir run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
BASE_PATH = "/"
NODE_ENV = "development"
VAPID_PUBLIC_KEY = "BJIqa889HJWog7fNnC2mNRyBNFGlldg68XjzKG9vczRfKE3n9gpwqqHhwc9frUS5_n_CenoGP2Poy8A4j-8raks"
VAPID_SUBJECT = "mailto:admin@neonoir.app"

[objectStorage]
defaultBucketID = "replit-objstore-965b5d69-ed31-46f3-a95e-a673f3a8f562"
